<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/values/styles.xml -->
<resources>

    <!-- ──────────────────────────────────────────────────────────
         LaunchTheme: shown while Flutter engine is loading.
         Uses a black window background with centred AutoCare icon.
         Parent changed to Theme.MaterialComponents for Stripe compatibility.
    ────────────────────────────────────────────────────────────── -->
    <style name="LaunchTheme" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Full-screen, no status bar flicker -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- Translucent status/nav bars so black shows through -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!-- Dark background for Stripe compatibility -->
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">#D4FF00</item>
    </style>

    <!-- ──────────────────────────────────────────────────────────
         NormalTheme: applied once the Flutter UI is ready.
         Transparent so Flutter draws the entire screen.
    ────────────────────────────────────────────────────────────── -->
    <style name="NormalTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- Let Flutter control status/nav bar colours -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!-- Dark background for Stripe compatibility -->
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">#D4FF00</item>
    </style>

</resources>
